# NVIDIA NIM API key (free tier) - https://build.nvidia.com/
NVIDIA_API_KEY=

# Postgres connection string used by src/storage and src/mcp
POSTGRES_URL=

# Kafka bootstrap broker address (host:port), e.g. localhost:9092
KAFKA_BROKER=

# Spark watchdog: restart from checkpoint if no micro-batch heartbeat arrives.
STREAM_STALL_TIMEOUT_SECONDS=180
STREAM_RESTART_LIMIT=5
STREAM_RESTART_BACKOFF_SECONDS=10
